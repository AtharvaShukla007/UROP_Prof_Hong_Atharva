# Copy to .env and fill in only what you actually use. Never commit .env.
#
# Default paid API budget is ZERO. Leave the *_API_KEY lines below empty/unset
# unless you have explicit approval for real spend (see docs/compute_budget.md).
# scripts/run_text_pilot.py refuses to run against a paid backend regardless.

# --- Upstream AutoTraceGT (external/autotracegt_upstream), only if you
#     deliberately choose a paid endpoint (not the default path) ---
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# --- Local endpoint (see src/urop/autotrace_adapter.register_local_endpoint) ---
# Set automatically to a harmless dummy value by register_local_endpoint;
# only set it here if you want a specific value.
# LOCAL_ENDPOINT_API_KEY=local-no-auth

# --- Optional upstream pipeline defaults (read in autotracegt/utils/utils.py) ---
# MODEL=
# CONCURRENCY=8
# JSON_RETRIES=3
# OFFLINE_CODING_DIR=
